---
const year = new Date().getFullYear();
---
<footer class="foot wood">
  <div class="stripe-h" aria-hidden="true"></div>
  <div class="wrap row">
    <div>
      <p class="made">Hand-built in a Cambridge dorm, the modern garage.</p>
      <p class="small">© {year} Wood Moore · All art original · No logos were harmed</p>
    </div>
    <ul class="links">
      <li><a href="mailto:hwmoore@mit.edu">hwmoore@mit.edu</a></li>
      <li><a href="/contact/">Contact</a></li>
    </ul>
  </div>
</footer>

<style>
  .foot {
    margin-top: 0; position: relative; z-index: 2; padding-top: 16px;
    clip-path: polygon(0 14px, 5% 4px, 11% 16px, 18% 2px, 24% 13px, 31% 5px, 38% 18px, 45% 3px, 52% 12px, 58% 0, 65% 15px, 72% 4px, 79% 17px, 86% 6px, 92% 14px, 100% 3px, 100% 100%, 0 100%);
  }
  .foot .stripe-h { display: none; }
  .row { display: flex; justify-content: space-between; align-items: center; gap: 24px; flex-wrap: wrap; padding-block: 36px 40px; }
  .made { font-family: var(--font-hand); transform: rotate(-2deg); font-size: clamp(20px, 3vw, 28px); margin: 0 0 4px; color: var(--beige); text-shadow: 2px 2px 0 var(--walnut-dark); }
  .small { font-family: var(--font-term); font-size: 18px; letter-spacing: .05em; margin: 0; color: #E8DCC4cc; }
  .links { list-style: none; margin: 0; padding: 0; display: flex; gap: 20px; font-family: var(--font-term); font-size: 22px; }
</style>

---
// A blob of spilled dye with a few droplets. Shape is seeded so it stays put between builds.
interface Props { seed: number; color: string; class?: string; style?: string }
const { seed, color, class: cls = '', style = '' } = Astro.props;
let t = seed * 9301 + 49297;
const rnd = () => { t = (t * 9301 + 49297) % 233280; return t / 233280; };
const n = 14;
const pts = Array.from({ length: n }, (_, i) => {
  const a = (i / n) * Math.PI * 2;
  const r = 60 + rnd() * 35 + (rnd() < 0.3 ? 25 : 0); // occasional spiky lobe
  return [100 + r * Math.cos(a), 100 + r * Math.sin(a)];
});
// smooth closed curve through midpoints
let d = '';
for (let i = 0; i < n; i++) {
  const p = pts[i], q = pts[(i + 1) % n];
  const mx = (p[0] + q[0]) / 2, my = (p[1] + q[1]) / 2;
  d += i === 0 ? `M${mx.toFixed(1)} ${my.toFixed(1)}` : `Q${p[0].toFixed(1)} ${p[1].toFixed(1)} ${mx.toFixed(1)} ${my.toFixed(1)}`;
}
const p0 = pts[0], p1 = pts[1];
d += `Q${p1[0].toFixed(1)} ${p1[1].toFixed(1)} ${((p1[0] + pts[2][0]) / 2).toFixed(1)} ${((p1[1] + pts[2][1]) / 2).toFixed(1)}Z`;
const drops = Array.from({ length: 6 }, () => {
  const a = rnd() * Math.PI * 2, r = 110 + rnd() * 40;
  return { x: 100 + r * Math.cos(a), y: 100 + r * Math.sin(a), s: 4 + rnd() * 10 };
});
void p0;
---
<svg class={`splat ${cls}`} style={style} viewBox="-50 -50 300 300" aria-hidden="true">
  <path d={d} fill={color} />
  {drops.map((o) => <circle cx={o.x} cy={o.y} r={o.s} fill={color} />)}
</svg>
<style>
  .splat { position: absolute; pointer-events: none; z-index: 0; opacity: .9; mix-blend-mode: multiply; }
</style>

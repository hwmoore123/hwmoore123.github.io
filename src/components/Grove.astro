---
// A giant trippy tree with a crowd of animals around it. Pure decoration, original art.
import Bear from './Bear.astro';
import Critter from './Critter.astro';

const P = ['#FF2E97', '#FF8A1E', '#FDB827', '#B6FF3B', '#00C2B8', '#7B2CFF'];
const rot = (k: number) => [...P.slice(k), ...P.slice(0, k)];

// Wobbly hand-drawn blob around (cx, cy).
const blob = (cx: number, cy: number, r: number, s: number) => {
  const n = 14;
  const pts = Array.from({ length: n }, (_, i) => {
    const a = (i / n) * Math.PI * 2;
    const rr = r * (1 + 0.11 * Math.sin(i * 2.3 + s) + 0.06 * Math.sin(i * 5.1 + s * 1.7));
    return [cx + rr * Math.cos(a), cy + rr * Math.sin(a)];
  });
  const mid = (p: number[], q: number[]) => [(p[0] + q[0]) / 2, (p[1] + q[1]) / 2];
  let d = `M${mid(pts[n - 1], pts[0]).map((v) => v.toFixed(1)).join(' ')}`;
  pts.forEach((p, i) => {
    const m = mid(p, pts[(i + 1) % n]);
    d += ` Q${p[0].toFixed(1)} ${p[1].toFixed(1)} ${m[0].toFixed(1)} ${m[1].toFixed(1)}`;
  });
  return d + 'Z';
};
const spiral = (cx: number, cy: number, rMax: number, turns = 3) => {
  let d = '';
  for (let i = 0; i <= 70; i++) {
    const a = (i / 70) * turns * Math.PI * 2;
    const r = (rMax * i) / 70;
    d += `${i ? 'L' : 'M'}${(cx + r * Math.cos(a)).toFixed(1)} ${(cy + r * Math.sin(a)).toFixed(1)}`;
  }
  return d;
};

const canopy = [
  [220, 390, 72], [980, 390, 72], [300, 320, 104], [900, 320, 104],
  [420, 260, 134], [780, 260, 134], [380, 170, 92], [820, 170, 92],
  [500, 150, 112], [700, 150, 112], [600, 120, 100], [600, 250, 168],
  [510, 350, 100], [690, 350, 100],
].map(([cx, cy, r], i) => ({ cx, cy, r, i, d: blob(cx, cy, r, i * 1.9) }));

const orbs = [[330, 400, 60], [470, 420, 90], [610, 430, 50], [740, 420, 80], [880, 400, 70], [250, 440, 40], [960, 440, 46]];
const rays = Array.from({ length: 36 }, (_, i) => i * 10);
const branches = [
  'M560 520 C500 420 400 380 230 380',
  'M640 520 C700 420 800 380 970 380',
  'M570 500 C540 380 460 250 390 170',
  'M630 500 C660 380 740 250 810 170',
  'M600 480 C596 360 604 220 600 110',
];
const roots = [
  'M560 860 C520 900 440 900 360 950',
  'M640 860 C690 900 780 905 860 950',
  'M590 870 C580 920 560 950 540 990',
  'M620 870 C640 920 680 950 720 990',
];
const snake = 'M520 830 C640 815 690 780 560 762 C470 748 600 712 650 698 C706 682 580 646 552 634 C514 616 616 594 640 572';
---
<div class="grove" role="img" aria-label="A giant psychedelic tree surrounded by bears, eagles, buffalo, an owl, a fox, an elk and butterflies">
  <svg class="tree" viewBox="0 0 1200 1000" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
    <defs>
      {[0, 1, 2, 3, 4, 5].map((k) => (
        <radialGradient id={`leaf-${k}`} cx="50%" cy="50%" r={`${16 + k * 2}%`} spreadMethod="repeat">
          {rot(k).map((c, i) => <stop offset={`${(i / 6) * 100}%`} stop-color={c} />)}
          <stop offset="100%" stop-color={rot(k)[0]} />
        </radialGradient>
      ))}
      <linearGradient id="bark" x1="0" y1="0" x2=".14" y2=".03" spreadMethod="repeat">
        {['#7B2CFF', '#FF2E97', '#FF8A1E', '#FDB827', '#FF8A1E', '#FF2E97'].map((c, i) => <stop offset={`${(i / 6) * 100}%`} stop-color={c} />)}
        <stop offset="100%" stop-color="#7B2CFF" />
      </linearGradient>
      <linearGradient id="ground" x1="0" y1="0" x2="0" y2=".2" spreadMethod="repeat">
        {['#B6FF3B', '#00C2B8', '#7B2CFF', '#00C2B8'].map((c, i) => <stop offset={`${(i / 4) * 100}%`} stop-color={c} />)}
        <stop offset="100%" stop-color="#B6FF3B" />
      </linearGradient>
      <radialGradient id="orb">
        <stop offset="0" stop-color="#FFFBEA" /><stop offset=".45" stop-color="#FDB827" /><stop offset="1" stop-color="#FF2E97" />
      </radialGradient>
      <clipPath id="sun-clip"><circle cx="600" cy="420" r="500" /></clipPath>
    </defs>

    <!-- sunburst -->
    <g clip-path="url(#sun-clip)">
      <circle cx="600" cy="420" r="500" fill="#FDB827" opacity=".55" />
      <g class="rays">
        {rays.map((r, i) => (
          <path d="M600 420 L576 -300 L624 -300 Z" fill={P[i % 6]} opacity=".7" transform={`rotate(${r} 600 420)`} />
        ))}
      </g>
      {[440, 380, 320].map((r, i) => (
        <circle cx="600" cy="420" r={r} fill="none" stroke="#23170D" stroke-width="4" stroke-dasharray={`${10 + i * 6} ${14 + i * 4}`} opacity=".5" />
      ))}
    </g>

    <!-- ground -->
    <path d="M0 900 C200 856 400 924 600 880 C800 836 1000 912 1200 876 L1200 1000 L0 1000 Z" fill="url(#ground)" stroke="#23170D" stroke-width="5" />

    <g stroke="#23170D" stroke-linecap="round" stroke-linejoin="round">
      <!-- roots + branches: ink outline under a rainbow stroke -->
      <g filter="url(#rough)">
        {roots.map((d) => <path d={d} fill="none" stroke-width="40" />)}
        {roots.map((d) => <path d={d} fill="none" stroke="url(#bark)" stroke-width="28" />)}
        {branches.map((d) => <path d={d} fill="none" stroke-width="54" />)}
        {branches.map((d) => <path d={d} fill="none" stroke="url(#bark)" stroke-width="40" />)}
        <path d="M480 890 C540 800 560 700 548 580 C542 520 520 480 496 456 L704 456 C680 480 658 520 652 580 C640 700 660 800 720 890 Z" fill="url(#bark)" stroke-width="7" />
        <path d="M560 860 C580 780 570 700 590 620 M640 860 C620 780 640 700 612 610 M520 870 C540 820 540 760 548 700" fill="none" stroke-width="4" opacity=".6" />
      </g>

      <!-- knot eye on the trunk -->
      <ellipse cx="600" cy="640" rx="42" ry="30" fill="#F4ECDA" stroke-width="6" />
      <path class="knot" d={spiral(600, 640, 26)} fill="none" stroke-width="4" />

      <!-- snake around the trunk -->
      <path d={snake} fill="none" stroke-width="26" />
      <path d={snake} fill="none" stroke="#B6FF3B" stroke-width="17" />
      <path d={snake} fill="none" stroke="#FF2E97" stroke-width="17" stroke-dasharray="14 16" stroke-linecap="butt" />
      <ellipse cx="648" cy="566" rx="20" ry="14" fill="#B6FF3B" stroke-width="5" transform="rotate(-30 648 566)" />
      <circle cx="652" cy="560" r="4" fill="#23170D" stroke="none" />
      <path class="tongue" d="M664 556 l16 -10 m-6 4 l8 2" fill="none" stroke="#FF2E97" stroke-width="4" />

      <!-- hanging orbs -->
      {orbs.map(([x, y, len], i) => (
        <g class="orb" style={`animation-delay:${-i * 0.7}s`}>
          <path d={`M${x} ${y} V${y + len}`} stroke-width="3" />
          <circle cx={x} cy={y + len + 14} r="14" fill="url(#orb)" stroke-width="4" />
        </g>
      ))}

      <!-- canopy -->
      {canopy.map((b) => (
        <g class="leaf" style={`animation-delay:${-b.i * 0.45}s`}>
          <path d={b.d} fill={`url(#leaf-${b.i % 6})`} stroke-width="6" />
          {b.r > 95 && <path d={spiral(b.cx, b.cy, b.r * 0.35)} fill="none" stroke-width="4" opacity=".75" />}
        </g>
      ))}

      <!-- mushrooms at the roots -->
      {[[300, 930, 1], [350, 948, .7], [880, 935, .9], [930, 952, .6]].map(([x, y, s]) => (
        <g transform={`translate(${x} ${y}) scale(${s})`}>
          <path d="M-10 0 C-12 -20 -8 -34 -6 -40 L6 -40 C8 -34 12 -20 10 0 Z" fill="#F4ECDA" stroke-width="5" />
          <path d="M-46 -38 C-40 -82 40 -82 46 -38 Z" fill="#FF2E97" stroke-width="5" />
          <circle cx="-20" cy="-56" r="7" fill="#F4ECDA" stroke-width="3" />
          <circle cx="12" cy="-64" r="6" fill="#F4ECDA" stroke-width="3" />
          <circle cx="28" cy="-46" r="5" fill="#F4ECDA" stroke-width="3" />
        </g>
      ))}
    </g>
  </svg>

  <!-- the crowd -->
  <div class="a eagle e1"><Critter variant="eagle" uid="g-e1" /></div>
  <div class="a eagle e2"><Critter variant="eagle" uid="g-e2" fur={['#00C2B8', '#7B2CFF', '#FF2E97', '#FDB827']} /></div>
  <div class="a peek p1"><Bear variant="head" uid="g-h1" label="" fur={['#B6FF3B', '#00C2B8', '#7B2CFF', '#FF2E97']} /></div>
  <div class="a peek p2"><Bear variant="head" uid="g-h2" label="" fur={['#FDB827', '#FF2E97', '#7B2CFF']} /></div>
  <div class="a owl"><Critter variant="owl" uid="g-owl" fur={['#7B2CFF', '#00C2B8', '#B6FF3B']} /></div>
  <div class="a elk"><Critter variant="elk" uid="g-elk" fur={['#FF8A1E', '#FDB827', '#FF2E97', '#7B2CFF']} /></div>
  <div class="a buff b1"><Critter variant="buffalo" uid="g-b1" fur={['#FF8A1E', '#7B2CFF', '#FF2E97', '#FDB827']} /></div>
  <div class="a buff b2"><Critter variant="buffalo" uid="g-b2" fur={['#00C2B8', '#B6FF3B', '#7B2CFF', '#FF2E97']} /></div>
  <div class="a bear r1"><Bear variant="run" uid="g-run" label="" /></div>
  <div class="a bear r2"><Bear variant="math" uid="g-math" label="" fur={['#7B2CFF', '#00C2B8', '#B6FF3B', '#FDB827', '#FF2E97']} /></div>
  <div class="a fox"><Critter variant="fox" uid="g-fox" /></div>
  {[1, 2, 3, 4, 5, 6].map((n) => (
    <div class={`a fly f${n}`}><Critter variant="butterfly" uid={`g-f${n}`} fur={rot(n)} /></div>
  ))}
</div>

<style>
  .grove { position: relative; width: 100%; max-width: 1180px; margin: 0 auto; aspect-ratio: 1200 / 1000; }
  .tree { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .a { position: absolute; }
  .a :global(svg) { filter: drop-shadow(3px 3px 0 #23170D) drop-shadow(-2px -2px 0 #fff); }

  .e1 { left: 2%; top: 3%; width: 21%; animation: soar 9s ease-in-out infinite; }
  .e2 { right: 2%; top: 10%; width: 16%; animation: soar 11s ease-in-out -4s infinite reverse; }
  .p1 { left: 31%; top: 6%; width: 9%; transform: rotate(-18deg); }
  .p2 { left: 63%; top: 4%; width: 8%; transform: rotate(14deg); }
  .owl { left: 15%; top: 25%; width: 7%; }
  .elk { right: 1%; top: 46%; width: 14%; }
  .b1 { left: -1%; top: 66%; width: 25%; }
  .b2 { right: 13%; top: 68%; width: 22%; transform: scaleX(-1); }
  .r1 { left: 24%; top: 61%; width: 12%; }
  .r2 { left: 62%; top: 60%; width: 12%; }
  .fox { left: 42%; top: 80%; width: 13%; }
  .fly { width: 6%; animation: drift 7s ease-in-out infinite; }
  .f1 { left: 12%; top: 50%; }
  .f2 { left: 46%; top: 50%; width: 5%; animation-delay: -2s; }
  .f3 { left: 86%; top: 32%; animation-delay: -4s; }
  .f4 { left: 40%; top: 2%; width: 5%; animation-delay: -1s; }
  .f5 { left: 78%; top: 82%; animation-delay: -3s; }
  .f6 { left: 6%; top: 40%; width: 5%; animation-delay: -5s; }

  @keyframes soar {
    0%, 100% { transform: translate(0, 0) rotate(-4deg); }
    50% { transform: translate(4%, 14%) rotate(6deg); }
  }
  @keyframes drift {
    0%, 100% { transform: translate(0, 0) rotate(-10deg); }
    33% { transform: translate(60%, -80%) rotate(12deg); }
    66% { transform: translate(-50%, -30%) rotate(-4deg); }
  }

  .rays { transform-box: view-box; transform-origin: 600px 420px; animation: rays 50s linear infinite; }
  @keyframes rays { to { transform: rotate(360deg); } }
  .leaf { transform-box: fill-box; transform-origin: center; animation: breathe 4.5s ease-in-out infinite; }
  @keyframes breathe { 0%, 100% { transform: scale(1) rotate(0); } 50% { transform: scale(1.06) rotate(3deg); } }
  .orb { transform-box: fill-box; transform-origin: 50% 0; animation: swing 3s ease-in-out infinite alternate; }
  @keyframes swing { from { transform: rotate(-9deg); } to { transform: rotate(9deg); } }
  .knot { transform-box: fill-box; transform-origin: center; animation: spin 4s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }
  .tongue { animation: flick 1.6s steps(2) infinite; }
  @keyframes flick { 50% { opacity: 0; } }

  :global(html[data-dose='sober']) .grove * { animation: none !important; }
</style>

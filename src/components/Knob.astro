---
// 1970s hi-fi volume knob. Three detents; real radios underneath for keyboard + screen readers.
const doses = [
  { v: 'sober', label: 'Sober' },
  { v: 'contact', label: 'Contact high' },
  { v: 'trip', label: 'Full trip' },
];
---
<form class="dial wood" id="dial" aria-label="Effect intensity">
  <fieldset>
    <legend class="sr-only">Effect intensity</legend>
    <div class="face">
      <button type="button" class="knob" id="knob" aria-label="Turn the intensity knob (cycles Sober, Contact high, Full trip)">
        <span class="grip" aria-hidden="true"></span>
        <span class="pointer" aria-hidden="true"></span>
      </button>
      {doses.map((d, i) => (
        <label class={`tick t${i}`}>
          <input type="radio" name="dose" value={d.v} />
          <span>{d.label}</span>
        </label>
      ))}
    </div>
    <p class="cap" aria-hidden="true">DOSE</p>
  </fieldset>
</form>

<style>
  .dial {
    position: fixed; right: 14px; bottom: 14px; z-index: 75;
    width: 184px; padding: 10px 10px 6px;
    border-radius: 14px;
    border: 3px solid var(--walnut-dark);
    box-shadow: 0 6px 0 rgba(0,0,0,.25), inset 0 1px 0 #fff3;
  }
  fieldset { border: 0; margin: 0; padding: 0; }
  .face {
    position: relative; height: 112px;
    background: linear-gradient(180deg, #F1E7D1, var(--beige-3));
    border-radius: 8px; border: 2px solid var(--walnut-dark);
  }
  .knob {
    --rot: 0deg;
    position: absolute; left: 50%; top: 56px; width: 58px; height: 58px; margin: -29px 0 0 -29px;
    border-radius: 50%; border: 0; padding: 0; cursor: grab;
    background:
      radial-gradient(circle at 35% 30%, #fff8 0 6%, transparent 30%),
      conic-gradient(from 0deg, #c9c2b3, #7d7568, #e8e1d1, #6f685c, #d2cbbb, #7d7568, #c9c2b3);
    box-shadow: 0 4px 0 #2a1a0d, 0 0 0 4px #3a2312, 0 6px 12px #0006;
    transform: rotate(var(--rot));
    transition: transform .5s cubic-bezier(.3, 1.6, .5, 1);
  }
  .grip {
    position: absolute; inset: 7px; border-radius: 50%;
    background: repeating-conic-gradient(#0002 0 4deg, transparent 4deg 12deg);
  }
  .pointer {
    position: absolute; left: 50%; top: 4px; width: 5px; height: 16px; margin-left: -2.5px;
    border-radius: 3px; background: var(--magenta); box-shadow: 0 0 6px var(--magenta);
  }
  .tick {
    position: absolute; font-family: var(--font-term); font-size: 15px; line-height: 1;
    letter-spacing: .04em; text-transform: uppercase; color: var(--ink);
    cursor: pointer; white-space: nowrap;
    display: flex; align-items: center; gap: 3px;
  }
  .tick input { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .tick span { padding: 2px 4px; border-radius: 3px; }
  .tick input:checked + span { background: var(--crt); color: var(--phosphor); }
  .tick input:focus-visible + span { outline: 2px solid var(--violet); outline-offset: 2px; }
  .t0 { left: 6px; bottom: 6px; }
  .t1 { left: 50%; top: 4px; transform: translateX(-50%); }
  .t2 { right: 6px; bottom: 6px; }
  .cap { margin: 4px 0 0; text-align: center; font-family: var(--font-term); font-size: 14px; letter-spacing: .4em; color: var(--gold); }
  @media (max-width: 560px) {
    .dial { width: 128px; right: 6px; bottom: 6px; padding: 4px 4px 0; border-width: 2px; }
    .face { height: 70px; }
    .knob { top: 36px; width: 34px; height: 34px; margin: -17px 0 0 -17px; box-shadow: 0 3px 0 #2a1a0d, 0 0 0 3px #3a2312; }
    .pointer { height: 10px; top: 2px; width: 4px; margin-left: -2px; }
    .tick { font-size: 11px; }
    .t0 { left: 2px; bottom: 3px; } .t2 { right: 2px; bottom: 3px; } .t1 { top: 2px; }
    .cap { font-size: 11px; margin-top: 1px; }
  }
</style>

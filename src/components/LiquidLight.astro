---
// Full-bleed liquid light show. A static poster gradient sits underneath as the fallback / Sober state.
---
<div class="liquid" aria-hidden="true">
  <div class="fallback"></div>
  <canvas id="liquid"></canvas>
</div>
<script>
  import '../scripts/liquid';
</script>
<style>
  .liquid { position: absolute; inset: 0; overflow: hidden; z-index: 0; }
  .fallback, canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  .fallback {
    background:
      radial-gradient(circle at 50% 50%, transparent 0 20%, rgba(123,44,255,.35) 70%),
      repeating-conic-gradient(from 0deg at 50% 50%,
        #FF2E97 0 13deg, #FF8A1E 0 26deg, #FDB827 0 39deg, #B6FF3B 0 52deg,
        #00C2B8 0 65deg, #009DDC 0 78deg, #7B2CFF 0 90deg);
  }
  canvas { opacity: 0; transition: opacity 1.2s ease; }
  canvas.on { opacity: 1; }
</style>

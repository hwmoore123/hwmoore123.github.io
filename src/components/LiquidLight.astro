---
// Full-bleed tie-dye spiral shader. When it can't run, the hero is transparent and the
// site-wide painted tie-dye (scripts/tiedye.ts) shows through instead.
---
<div class="liquid" aria-hidden="true">
  <canvas id="liquid"></canvas>
</div>
<script>
  import '../scripts/liquid';
</script>
<style>
  .liquid { position: absolute; inset: 0; overflow: hidden; z-index: 0; }
  canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  canvas { opacity: 0; transition: opacity 1.2s ease; }
  canvas.on { opacity: 1; }
</style>

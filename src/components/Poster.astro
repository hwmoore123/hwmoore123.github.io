---
// Small original poster per project. On hover the art folds into 6-way kaleidoscope symmetry.
interface Props { motif: 'mantis' | 'mandala' | 'candles' | 'spiral' | 'sun'; title: string }
const { motif, title } = Astro.props;
const id = `art-${motif}`;
const bg: Record<string, [string, string]> = {
  mantis: ['#B6FF3B', '#00C2B8'],
  mandala: ['#7B2CFF', '#FF2E97'],
  candles: ['#FF8A1E', '#7B2CFF'],
  spiral: ['#00C2B8', '#7B2CFF'],
  sun: ['#FF2E97', '#FF8A1E'],
};
const [c1, c2] = bg[motif];
const rays = Array.from({ length: 16 }, (_, i) => i * 22.5);
const mandalaNodes = [0, 1, 2].flatMap((ring) =>
  Array.from({ length: 6 + ring * 6 }, (_, i) => {
    const r = 26 + ring * 24, a = (i / (6 + ring * 6)) * Math.PI * 2 + ring * 0.3;
    return { x: 100 + r * Math.cos(a), y: 100 + r * Math.sin(a), ring };
  }),
);
const spiralPath = (offset: number) => {
  let d = '';
  for (let i = 0; i <= 220; i++) {
    const a = i * 0.075, r = 8 + a * 9.5 + offset;
    d += `${i ? 'L' : 'M'}${(100 + r * Math.cos(a)).toFixed(1)} ${(100 + r * Math.sin(a)).toFixed(1)}`;
  }
  return d;
};
---
<figure class="poster" role="img" aria-label={`Original poster art for ${title}`}>
  <svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <radialGradient id={`bg-${motif}`} cx="50%" cy="45%" r="70%">
        <stop offset="0" stop-color={c1} /><stop offset="1" stop-color={c2} />
      </radialGradient>
      <pattern id={`news-${motif}`} width="24" height="10" patternUnits="userSpaceOnUse">
        <rect width="24" height="10" fill="#EFE6D2" />
        <rect x="1" y="2" width="14" height="1.6" fill="#555" /><rect x="17" y="2" width="6" height="1.6" fill="#555" />
        <rect x="1" y="6" width="8" height="1.6" fill="#777" /><rect x="11" y="6" width="12" height="1.6" fill="#777" />
      </pattern>
      <clipPath id={`wedge-${motif}`}><path d="M100 100 L13.4 -50 L186.6 -50 Z" /></clipPath>
      <g id={id}>
        <rect width="200" height="200" fill={`url(#bg-${motif})`} />
        {motif === 'mantis' && (
          <g stroke="#23170D" stroke-width="2.4" stroke-linejoin="round" stroke-linecap="round">
            <path d="M118 40 L88 22 M126 38 L148 14" fill="none" />
            <path d="M108 44 L132 40 L124 60 Z" fill={`url(#news-${motif})`} />
            <circle cx="112" cy="46" r="5" fill="#FF2E97" /><circle cx="128" cy="44" r="5" fill="#FF2E97" />
            <path d="M118 58 L112 92 L120 94 L124 60 Z" fill={`url(#news-${motif})`} />
            <path d="M114 70 L88 86 L96 58 M96 58 L80 52" fill="none" stroke-width="5" stroke="#EFE6D2" />
            <path d="M114 70 L88 86 L96 58 M96 58 L80 52" fill="none" />
            <path d="M120 72 L146 90 L140 62 M140 62 L156 56" fill="none" stroke-width="5" stroke="#EFE6D2" />
            <path d="M120 72 L146 90 L140 62 M140 62 L156 56" fill="none" />
            <path d="M112 92 C96 120 98 160 116 182 C134 160 136 120 120 94 Z" fill={`url(#news-${motif})`} />
            <path d="M112 112 L80 140 L74 176 M122 112 L152 140 L160 176 M114 100 L86 112 L70 128 M120 100 L150 112 L166 128" fill="none" />
            <text x="100" y="196" text-anchor="middle" font-family="VT323, monospace" font-size="13" fill="#23170D" stroke="none">NEWS ▲ +2.3% · TICK</text>
          </g>
        )}
        {motif === 'mandala' && (
          <g>
            {[0, 30, 60, 90, 120, 150].map((r) => (
              <ellipse cx="100" cy="100" rx="88" ry="26" fill="none" stroke="#B6FF3B" stroke-width="1.2" opacity=".55" transform={`rotate(${r} 100 100)`} />
            ))}
            {mandalaNodes.map((n, i) =>
              mandalaNodes.slice(i + 1).filter((m) => Math.hypot(m.x - n.x, m.y - n.y) < 30).map((m) => (
                <line x1={n.x} y1={n.y} x2={m.x} y2={m.y} stroke="#E8DCC4" stroke-width="1.4" />
              )),
            )}
            {mandalaNodes.map((n) => <line x1="100" y1="100" x2={n.x} y2={n.y} stroke="#FF8A1E" stroke-width=".8" opacity={n.ring === 0 ? 1 : 0.35} />)}
            {mandalaNodes.map((n) => <circle cx={n.x} cy={n.y} r={6 - n.ring * 1.4} fill={['#FF8A1E', '#B6FF3B', '#00C2B8'][n.ring]} stroke="#23170D" stroke-width="1.2" />)}
            <circle cx="100" cy="100" r="10" fill="#E8DCC4" stroke="#23170D" stroke-width="2" />
            <circle cx="100" cy="100" r="4" fill="#FF2E97" />
          </g>
        )}
        {motif === 'candles' && (
          <g stroke="#23170D" stroke-width="2">
            <path d="M0 170 Q50 160 100 172 T200 168 V200 H0 Z" fill="#5C3A21" />
            {[
              { x: 30, top: 110, h: 50, c: '#B6FF3B' }, { x: 62, top: 80, h: 70, c: '#FF2E97' },
              { x: 96, top: 60, h: 60, c: '#B6FF3B' }, { x: 130, top: 90, h: 55, c: '#FF2E97' },
              { x: 164, top: 45, h: 90, c: '#B6FF3B' },
            ].map((k) => (
              <g>
                <line x1={k.x} y1={k.top - 20} x2={k.x} y2={k.top} />
                <path d={`M${k.x} ${k.top - 34} C${k.x - 7} ${k.top - 24} ${k.x - 4} ${k.top - 18} ${k.x} ${k.top - 18} C${k.x + 4} ${k.top - 18} ${k.x + 7} ${k.top - 24} ${k.x} ${k.top - 34} Z`} fill="#FDB827" />
                <path d={`M${k.x - 11} ${k.top} H${k.x + 11} V${k.top + k.h} C${k.x + 11} ${k.top + k.h + 14} ${k.x + 5} ${k.top + k.h + 16} ${k.x + 5} ${k.top + k.h + 6} C${k.x + 5} ${k.top + k.h + 22} ${k.x - 3} ${k.top + k.h + 22} ${k.x - 3} ${k.top + k.h + 8} C${k.x - 6} ${k.top + k.h + 14} ${k.x - 11} ${k.top + k.h + 10} ${k.x - 11} ${k.top + k.h} Z`} fill={k.c} />
              </g>
            ))}
          </g>
        )}
        {motif === 'spiral' && (
          <g fill="none" stroke-linecap="round">
            <path d={spiralPath(0)} stroke="#E03A3E" stroke-width="16" />
            <path d={spiralPath(-4)} stroke="#E8DCC4" stroke-width="1.2" />
            <path d={spiralPath(0)} stroke="#E8DCC4" stroke-width="1.2" />
            <path d={spiralPath(4)} stroke="#E8DCC4" stroke-width="1.2" />
            <circle cx="100" cy="100" r="8" fill="#B6FF3B" stroke="#23170D" stroke-width="2" />
            <text x="100" y="192" text-anchor="middle" font-family="VT323, monospace" font-size="14" fill="#E8DCC4">LAP 1 OF ∞</text>
          </g>
        )}
        {motif === 'sun' && (
          <g stroke="#23170D" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
            {rays.map((r, i) => (
              <path d="M100 30 L106 52 L94 52 Z" fill={i % 2 ? '#B6FF3B' : '#FDB827'} transform={`rotate(${r} 100 86)`} />
            ))}
            <circle cx="100" cy="86" r="34" fill="#FDB827" />
            <path d="M84 80 q5 -6 10 0 M106 80 q5 -6 10 0" fill="none" />
            <path d="M86 96 q14 12 28 0" fill="none" />
            <circle cx="82" cy="92" r="4" fill="#FF8A1E" stroke="none" /><circle cx="118" cy="92" r="4" fill="#FF8A1E" stroke="none" />
            <path d="M92 118 L78 146 L62 156" fill="none" stroke-width="5" />
            <path d="M108 118 L120 140 L140 150" fill="none" stroke-width="5" />
            <path d="M54 152 h14 l2 8 h-20 Z" fill="#00C2B8" />
            <path d="M136 144 l14 4 l-2 8 l-18 -4 Z" fill="#00C2B8" />
            <path d="M30 170 H80 M120 176 H176" stroke="#E8DCC4" stroke-width="2" stroke-dasharray="6 6" />
          </g>
        )}
      </g>
    </defs>

    <use href={`#${id}`} class="plain" />
    <g class="kaleido">
      <g class="spin">
        {[0, 1, 2, 3, 4, 5].map((i) => (
          <g transform={`rotate(${i * 60} 100 100)`}>
            <g clip-path={`url(#wedge-${motif})`}>
              <use href={`#${id}`} transform={i % 2 ? 'translate(200 0) scale(-1 1)' : undefined} />
            </g>
          </g>
        ))}
      </g>
    </g>
  </svg>
</figure>

<style>
  .poster { margin: 0; aspect-ratio: 1; overflow: hidden; border: 3px solid var(--ink); border-radius: 6px; background: var(--ink); position: relative; }
  .poster::after { /* halftone + paper on top of the art */
    content: ''; position: absolute; inset: 0; pointer-events: none; mix-blend-mode: multiply;
    background-image: radial-gradient(rgba(35, 23, 13, .18) 1px, transparent 1.3px); background-size: 5px 5px;
  }
  svg { display: block; width: 100%; height: 100%; }
  .kaleido { opacity: 0; transition: opacity .6s ease; }
  .plain { transition: opacity .6s ease; }
  .spin { transform-origin: 100px 100px; transform-box: view-box; }
  :global(.stub:hover) .kaleido, :global(.stub:focus-within) .kaleido { opacity: 1; }
  :global(.stub:hover) .plain, :global(.stub:focus-within) .plain { opacity: 0; }
  :global(html:not([data-dose='sober']) .stub:hover) .spin { animation: kspin 40s linear infinite; }
  :global(html[data-dose='trip'] .stub:hover) .spin { animation-duration: 14s; }
  @keyframes kspin { to { transform: rotate(360deg); } }
</style>

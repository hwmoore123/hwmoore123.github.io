---
// Beige computer that boots and types the bio.
interface Props { boot: string[]; bio: string[] }
const { boot, bio } = Astro.props;
---
<div class="computer">
  <div class="bezel">
    <div class="screen crt">
      <pre id="term" aria-hidden="true" data-boot={JSON.stringify(boot)} data-bio={JSON.stringify(bio)}></pre>
      <div class="sr-only">
        {boot.map((l) => <p>{l}</p>)}
        {bio.map((l) => <p>{l}</p>)}
      </div>
    </div>
  </div>
  <div class="chin">
    <span class="badge">WM-1</span>
    <span class="vents" aria-hidden="true"></span>
    <button type="button" class="reboot" id="reboot">Reboot</button>
  </div>
  <div class="keys" aria-hidden="true">
    {Array.from({ length: 36 }).map(() => <i></i>)}
  </div>
</div>

<script>
  import { getDose } from '../scripts/dose';
  const pre = document.getElementById('term') as HTMLPreElement | null;
  let timer = 0;
  function run() {
    if (!pre) return;
    clearTimeout(timer);
    const boot: string[] = JSON.parse(pre.dataset.boot || '[]');
    const bio: string[] = JSON.parse(pre.dataset.bio || '[]');
    const full = [...boot, '', ...bio].join('\n');
    if (getDose() === 'sober') { pre.textContent = full; return; }
    const fast = getDose() === 'trip';
    pre.textContent = '';
    let i = 0;
    const bootLen = boot.join('\n').length;
    const tick = () => {
      // boot lines snap in a line at a time; the bio types by character
      if (i < bootLen) {
        const nl = full.indexOf('\n', i + 1);
        i = nl < 0 ? full.length : nl;
        pre.textContent = full.slice(0, i) + '█';
        timer = window.setTimeout(tick, fast ? 120 : 320);
        return;
      }
      i += fast ? 3 : 1;
      pre.textContent = full.slice(0, i) + (i < full.length ? '█' : '');
      if (i < full.length) timer = window.setTimeout(tick, full[i] === '\n' ? 260 : fast ? 10 : 24);
      else pre.textContent = full + ' █';
    };
    tick();
  }
  const io = new IntersectionObserver(([e]) => { if (e.isIntersecting) { run(); io.disconnect(); } });
  if (pre) io.observe(pre);
  document.getElementById('reboot')?.addEventListener('click', run);
</script>

<style>
  .computer {
    background: linear-gradient(180deg, #EFE5CF, #D8C9A8);
    border: 3px solid #8b7a5c; border-radius: 18px 18px 10px 10px;
    padding: 18px 18px 10px;
    box-shadow: 0 10px 0 #9c8a68, 0 18px 30px rgba(0,0,0,.35);
  }
  .bezel { background: #3a352c; padding: 14px; border-radius: 14px; box-shadow: inset 0 4px 10px #000a; }
  .screen { border-radius: 18px / 26px; min-height: 340px; padding: 20px 22px; overflow: hidden; }
  pre {
    margin: 0; white-space: pre-wrap; word-break: break-word;
    font-family: var(--font-term); font-size: clamp(19px, 2.2vw, 24px); line-height: 1.3; color: var(--phosphor);
  }
  .chin { display: flex; align-items: center; gap: 14px; padding: 10px 4px 2px; }
  .badge { font-family: var(--font-display); color: var(--walnut); font-size: 20px; }
  .vents { flex: 1; height: 14px; background: repeating-linear-gradient(90deg, #8b7a5c 0 3px, transparent 3px 8px); border-radius: 3px; opacity: .6; }
  .reboot {
    font-family: var(--font-term); font-size: 18px; text-transform: uppercase; letter-spacing: .08em;
    background: var(--orange); color: var(--ink); border: 2px solid var(--walnut-dark); border-radius: 4px;
    padding: 3px 10px; cursor: pointer; box-shadow: 0 3px 0 var(--walnut-dark);
  }
  .reboot:active { transform: translateY(3px); box-shadow: none; }
  .keys {
    margin-top: 14px; display: grid; grid-template-columns: repeat(12, 1fr); gap: 4px;
    background: #cbbb98; padding: 8px; border-radius: 6px; border: 2px solid #8b7a5c;
  }
  .keys i { display: block; height: 16px; background: linear-gradient(#f4ecd9, #d9cba9); border-radius: 3px; box-shadow: 0 2px 0 #8b7a5c; }
  .keys i:nth-child(7n) { background: linear-gradient(#ffb36b, var(--orange)); }
</style>

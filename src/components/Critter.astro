---
// Original psychedelic critters for the grove: eagle, buffalo, owl, fox, elk, butterfly.
// Chunky ink outlines, rainbow tie-dye fur, spiral eyes. Decorative only.
interface Props {
  variant: 'eagle' | 'buffalo' | 'owl' | 'fox' | 'elk' | 'butterfly';
  uid: string;
  fur?: string[];
}
const { variant, uid, fur = ['#FF2E97', '#FF8A1E', '#FDB827', '#B6FF3B', '#00C2B8', '#7B2CFF'] } = Astro.props;

const spiral = (cx: number, cy: number, rMax: number, turns = 3) => {
  let d = '';
  const steps = 60;
  for (let i = 0; i <= steps; i++) {
    const a = (i / steps) * turns * Math.PI * 2;
    const r = (rMax * i) / steps;
    d += `${i ? 'L' : 'M'}${(cx + r * Math.cos(a)).toFixed(1)} ${(cy + r * Math.sin(a)).toFixed(1)}`;
  }
  return d;
};
const eye = (cx: number, cy: number, r: number, rev = false) => (
  { cx, cy, r, d: spiral(cx, cy, r * 0.85), rev }
);

const vb = {
  eagle: '0 0 240 150', buffalo: '0 0 260 180', owl: '0 0 120 160',
  fox: '0 0 200 160', elk: '0 0 200 240', butterfly: '0 0 60 50',
}[variant];

const F = `url(#fur-${uid})`;
const S = `url(#stripe-${uid})`;
const eyes = {
  eagle: [eye(113, 44, 5), eye(127, 44, 5, true)],
  buffalo: [eye(30, 98, 8)],
  owl: [eye(42, 58, 15), eye(78, 58, 15, true)],
  fox: [eye(84, 48, 6), eye(116, 48, 6, true)],
  elk: [eye(84, 100, 8), eye(116, 100, 8, true)],
  butterfly: [],
}[variant];

const eagleWing = 'M118 62 C92 30 52 16 6 24 L18 38 L4 46 L22 54 L10 64 L30 70 L22 80 L46 82 L42 92 L70 88 C90 88 106 84 118 80 Z';
const antler = 'M86 82 C72 60 56 40 30 8 M62 50 C48 44 34 46 18 56 M72 64 C60 54 54 40 58 22 M44 30 C40 22 34 16 22 20';
const bwing = 'M30 25 C20 4 2 2 4 16 C6 24 18 26 30 25 Z M30 26 C18 28 8 38 14 46 C20 50 28 40 30 26 Z';
---
<svg class={`critter critter-${variant}`} viewBox={vb} xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
  <defs>
    <radialGradient id={`fur-${uid}`} cx="50%" cy="40%" r="18%" spreadMethod="repeat">
      {fur.map((c, i) => <stop offset={`${(i / fur.length) * 100}%`} stop-color={c} />)}
      <stop offset="100%" stop-color={fur[0]} />
    </radialGradient>
    <linearGradient id={`stripe-${uid}`} x1="0" y1="0" x2=".22" y2=".12" spreadMethod="repeat">
      {fur.map((c, i) => <stop offset={`${(i / fur.length) * 100}%`} stop-color={c} />)}
      <stop offset="100%" stop-color={fur[0]} />
    </linearGradient>
  </defs>

  <g stroke="#23170D" stroke-width="3.5" stroke-linejoin="round" stroke-linecap="round">
    {variant === 'eagle' && (
      <g>
        <path class="flap" d={eagleWing} fill={S} />
        <g transform="translate(240 0) scale(-1 1)"><path class="flap" d={eagleWing} fill={S} /></g>
        <path d="M106 104 L134 104 L146 140 L120 132 L94 140 Z" fill="#F4ECDA" />
        <ellipse cx="120" cy="82" rx="20" ry="30" fill={F} />
        <circle cx="120" cy="46" r="17" fill="#F4ECDA" />
        <path d="M114 52 Q120 49 126 52 Q125 64 117 67 Q120 58 114 52 Z" fill="#FDB827" />
        <path d="M110 110 l-4 9 M116 112 l0 9 M124 112 l0 9 M130 110 l4 9" stroke="#FF8A1E" stroke-width="4" />
      </g>
    )}

    {variant === 'buffalo' && (
      <g>
        <path d="M226 68 C246 80 248 104 240 120" fill="none" />
        <circle cx="240" cy="126" r="8" fill="#7B2CFF" />
        {[78, 104, 184, 206].map((x) => (
          <g><rect x={x} y="108" width="18" height="52" rx="6" fill={F} /><rect x={x - 2} y="152" width="22" height="12" rx="3" fill="#23170D" /></g>
        ))}
        <path d="M70 60 C88 28 160 24 200 40 C232 50 238 86 232 114 C220 128 100 130 70 120 Z" fill={F} />
        <path d="M40 72 C44 24 100 6 136 34 C140 70 128 112 96 124 C70 128 48 112 40 72 Z" fill={S} />
        <g class="graze">
          <path d="M28 76 C12 70 8 54 18 42" fill="none" stroke-width="12" />
          <path d="M28 76 C12 70 8 54 18 42" fill="none" stroke="#F4ECDA" stroke-width="6" />
          <path d="M10 82 C6 104 14 136 34 142 C56 146 68 128 66 104 C64 82 48 72 30 72 C20 72 12 76 10 82 Z" fill="#7B2CFF" />
          <path d="M22 140 L28 162 L34 144 L40 164 L46 144 L52 160 L56 138 Z" fill="#FF2E97" />
          <ellipse cx="18" cy="128" rx="8" ry="5" fill="#23170D" />
          <circle cx="30" cy="98" r="10" fill="#F4ECDA" />
        </g>
      </g>
    )}

    {variant === 'owl' && (
      <g class="hoot">
        <path d="M24 34 L18 2 L44 24 Z M96 34 L102 2 L76 24 Z" fill="#FF8A1E" />
        <path d="M60 20 C100 20 108 70 104 110 C100 140 80 150 60 150 C40 150 20 140 16 110 C12 70 20 20 60 20 Z" fill={F} />
        <path d="M18 80 C4 104 8 132 26 142 C30 120 30 100 18 80 Z M102 80 C116 104 112 132 94 142 C90 120 90 100 102 80 Z" fill={S} />
        <path d="M40 104 l6 7 l6 -7 M56 104 l4 7 l6 -7 M70 104 l6 7 l6 -7 M46 120 l6 7 l6 -7 M62 120 l6 7 l6 -7" fill="none" stroke-width="2.5" />
        <circle cx="42" cy="58" r="20" fill="#F4ECDA" />
        <circle cx="78" cy="58" r="20" fill="#F4ECDA" />
        <path d="M53 72 L67 72 L60 88 Z" fill="#FDB827" />
        <path d="M44 150 l-4 8 M50 150 l0 9 M70 150 l0 9 M76 150 l4 8" stroke="#FF8A1E" stroke-width="4" />
      </g>
    )}

    {variant === 'fox' && (
      <g>
        <path class="wag" d="M126 150 C200 156 204 76 160 66 C182 98 172 128 128 128 Z" fill={S} />
        <path d="M150 70 C164 64 176 66 182 74 C170 72 162 76 158 82 Z" fill="#F4ECDA" />
        <path d="M70 152 C58 112 70 80 100 76 C130 80 142 112 130 152 Z" fill={F} />
        <path d="M88 152 C84 120 92 96 100 92 C108 96 116 120 112 152 Z" fill="#F4ECDA" />
        <path d="M60 34 L70 2 L90 28 L110 28 L130 2 L140 34 C146 56 122 80 100 86 C78 80 54 56 60 34 Z" fill="#FF8A1E" />
        <path d="M68 20 L72 10 L80 24 Z M132 20 L128 10 L120 24 Z" fill="#FF2E97" stroke-width="2" />
        <path d="M68 56 C80 74 92 82 100 86 C108 82 120 74 132 56 C120 62 108 62 100 70 C92 62 80 62 68 56 Z" fill="#F4ECDA" />
        <ellipse cx="100" cy="80" rx="6" ry="4.5" fill="#23170D" />
        <circle cx="84" cy="48" r="8" fill="#F4ECDA" />
        <circle cx="116" cy="48" r="8" fill="#F4ECDA" />
      </g>
    )}

    {variant === 'elk' && (
      <g>
        <g class="antlers">
          <path d={antler} fill="none" stroke-width="13" />
          <path d={antler} fill="none" stroke={S} stroke-width="7" />
          <g transform="translate(200 0) scale(-1 1)">
            <path d={antler} fill="none" stroke-width="13" />
            <path d={antler} fill="none" stroke={S} stroke-width="7" />
          </g>
        </g>
        <path d="M76 152 C70 190 60 226 54 240 L146 240 C140 226 130 190 124 152 Z" fill={S} />
        <ellipse cx="58" cy="92" rx="18" ry="9" transform="rotate(-24 58 92)" fill="#FDB827" />
        <ellipse cx="142" cy="92" rx="18" ry="9" transform="rotate(24 142 92)" fill="#FDB827" />
        <path d="M70 82 C70 58 130 58 130 82 C134 122 116 172 100 178 C84 172 66 122 70 82 Z" fill={F} />
        <ellipse cx="100" cy="158" rx="18" ry="16" fill="#F4ECDA" />
        <ellipse cx="100" cy="152" rx="9" ry="6" fill="#23170D" />
        <circle cx="84" cy="100" r="10" fill="#F4ECDA" />
        <circle cx="116" cy="100" r="10" fill="#F4ECDA" />
      </g>
    )}

    {variant === 'butterfly' && (
      <g stroke-width="2">
        <path class="bw" d={bwing} fill={S} />
        <g transform="translate(60 0) scale(-1 1)"><path class="bw" d={bwing} fill={S} /></g>
        <path d="M30 14 V42 M30 14 C28 6 24 4 22 2 M30 14 C32 6 36 4 38 2" fill="none" />
      </g>
    )}

    {eyes.map((e) => (
      <path class={`ceye${e.rev ? ' rev' : ''}`} d={e.d} fill="none" stroke-width={e.r > 10 ? 3 : 2} />
    ))}
  </g>
</svg>

<style>
  .critter { display: block; width: 100%; height: auto; overflow: visible; }
  .ceye { transform-box: fill-box; transform-origin: center; animation: cspin 2.6s linear infinite; }
  .ceye.rev { animation-direction: reverse; }
  @keyframes cspin { to { transform: rotate(360deg); } }
  .flap { transform-box: fill-box; transform-origin: 100% 60%; animation: flap 1.1s ease-in-out infinite alternate; }
  @keyframes flap { from { transform: rotate(-8deg) scaleY(1); } to { transform: rotate(10deg) scaleY(.7); } }
  .graze { transform-box: view-box; transform-origin: 62px 84px; animation: graze 3.4s ease-in-out infinite; }
  @keyframes graze { 0%, 100% { transform: rotate(0); } 50% { transform: rotate(-14deg); } }
  .hoot { transform-box: view-box; transform-origin: 60px 150px; animation: hoot 2.8s ease-in-out infinite; }
  @keyframes hoot { 0%, 100% { transform: rotate(-7deg); } 50% { transform: rotate(7deg); } }
  .wag { transform-box: fill-box; transform-origin: 0% 90%; animation: wag 1.4s ease-in-out infinite alternate; }
  @keyframes wag { from { transform: rotate(-6deg); } to { transform: rotate(8deg); } }
  .antlers { animation: glow 2s ease-in-out infinite alternate; }
  @keyframes glow { from { filter: drop-shadow(0 0 0 #B6FF3B); } to { filter: drop-shadow(0 0 6px #B6FF3B); } }
  .bw { transform-box: fill-box; transform-origin: 100% 50%; animation: bw .35s ease-in-out infinite alternate; }
  @keyframes bw { from { transform: scaleX(1); } to { transform: scaleX(.35); } }
  :global(html[data-dose='sober']) .critter * { animation: none !important; }
</style>

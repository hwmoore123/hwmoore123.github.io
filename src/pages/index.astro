---
import Base from '../layouts/Base.astro';
import LiquidLight from '../components/LiquidLight.astro';
import Drip from '../components/Drip.astro';
import Circuit from '../components/Circuit.astro';

const rings = Array.from({ length: 34 }, (_, i) => 14 + i * 13);
const bill = [
  { n: '01', t: 'Mantis', s: 'news that moves markets' },
  { n: '02', t: 'Weighted PALU', s: 'the shape of Internet traffic' },
  { n: '03', t: 'IMC Prosperity 4', s: 'market making, made the final' },
  { n: '04', t: 'Runner Development App', s: 'less admin, more miles' },
];
---
<Base title="Wood Moore" page="home">
  <section class="hero" aria-labelledby="name">
    <LiquidLight />

    <svg class="moire" viewBox="-460 -460 920 920" aria-hidden="true" preserveAspectRatio="xMidYMid slice">
      <g class="ringset a">{rings.map((r) => <circle r={r} />)}</g>
      <g class="ringset b" id="moire-b">{rings.map((r) => <circle r={r} />)}</g>
    </svg>

    <div class="wrap stage">
      <p class="presents term-label">Cambridge, Mass. · MIT Class of 2029</p>

      <h1 id="name" class="name breathe">
        <svg viewBox="0 0 1000 520" role="img" aria-labelledby="name-t">
          <title id="name-t">Wood Moore</title>
          <defs>
            <path id="arc-top" d="M70 255 Q500 -10 930 255" />
            <path id="arc-bot" d="M40 300 Q500 560 960 300" />
          </defs>
          <g class="letters display drift" font-family="Shrikhand, Georgia, serif">
            <g class="shadow" fill="#23170D" transform="translate(35 37)">
              <text font-size="190"><textPath href="#arc-top" startOffset="50%" text-anchor="middle" textLength="760" lengthAdjust="spacingAndGlyphs">WOOD</textPath></text>
              <text font-size="190"><textPath href="#arc-bot" startOffset="50%" text-anchor="middle" textLength="860" lengthAdjust="spacingAndGlyphs">MOORE</textPath></text>
            </g>
            <g class="shadow" fill="#61BB46" transform="translate(30 32)">
              <text font-size="190"><textPath href="#arc-top" startOffset="50%" text-anchor="middle" textLength="760" lengthAdjust="spacingAndGlyphs">WOOD</textPath></text>
              <text font-size="190"><textPath href="#arc-bot" startOffset="50%" text-anchor="middle" textLength="860" lengthAdjust="spacingAndGlyphs">MOORE</textPath></text>
            </g>
            <g class="shadow" fill="#FDB827" transform="translate(25 27)">
              <text font-size="190"><textPath href="#arc-top" startOffset="50%" text-anchor="middle" textLength="760" lengthAdjust="spacingAndGlyphs">WOOD</textPath></text>
              <text font-size="190"><textPath href="#arc-bot" startOffset="50%" text-anchor="middle" textLength="860" lengthAdjust="spacingAndGlyphs">MOORE</textPath></text>
            </g>
            <g class="shadow" fill="#F5821F" transform="translate(20 22)">
              <text font-size="190"><textPath href="#arc-top" startOffset="50%" text-anchor="middle" textLength="760" lengthAdjust="spacingAndGlyphs">WOOD</textPath></text>
              <text font-size="190"><textPath href="#arc-bot" startOffset="50%" text-anchor="middle" textLength="860" lengthAdjust="spacingAndGlyphs">MOORE</textPath></text>
            </g>
            <g class="shadow" fill="#E03A3E" transform="translate(15 17)">
              <text font-size="190"><textPath href="#arc-top" startOffset="50%" text-anchor="middle" textLength="760" lengthAdjust="spacingAndGlyphs">WOOD</textPath></text>
              <text font-size="190"><textPath href="#arc-bot" startOffset="50%" text-anchor="middle" textLength="860" lengthAdjust="spacingAndGlyphs">MOORE</textPath></text>
            </g>
            <g class="shadow" fill="#963D97" transform="translate(10 12)">
              <text font-size="190"><textPath href="#arc-top" startOffset="50%" text-anchor="middle" textLength="760" lengthAdjust="spacingAndGlyphs">WOOD</textPath></text>
              <text font-size="190"><textPath href="#arc-bot" startOffset="50%" text-anchor="middle" textLength="860" lengthAdjust="spacingAndGlyphs">MOORE</textPath></text>
            </g>
            <g class="shadow" fill="#009DDC" transform="translate(5 7)">
              <text font-size="190"><textPath href="#arc-top" startOffset="50%" text-anchor="middle" textLength="760" lengthAdjust="spacingAndGlyphs">WOOD</textPath></text>
              <text font-size="190"><textPath href="#arc-bot" startOffset="50%" text-anchor="middle" textLength="860" lengthAdjust="spacingAndGlyphs">MOORE</textPath></text>
            </g>
            <g class="face">
              <text font-size="190"><textPath href="#arc-top" startOffset="50%" text-anchor="middle" textLength="760" lengthAdjust="spacingAndGlyphs">WOOD</textPath></text>
              <text font-size="190"><textPath href="#arc-bot" startOffset="50%" text-anchor="middle" textLength="860" lengthAdjust="spacingAndGlyphs">MOORE</textPath></text>
            </g>
          </g>
          <g class="stars" aria-hidden="true">
            <path d="M500 220 l10 24 l26 2 l-20 16 l7 25 l-23 -14 l-23 14 l7 -25 l-20 -16 l26 -2 Z" />
          </g>
        </svg>
      </h1>

      <p class="tagline display vibe-lm">Computer Science, Economics, and Math Student @ MIT</p>

      <nav class="tickets" aria-label="Start here">
        <a class="ticket" href="/setlist/">See my projects</a>
        <a class="ticket alt" href="/about/">About me</a>
        <a class="ticket alt2" href="/backstage/">Get in touch</a>
      </nav>
    </div>
  </section>

  <Drip color="#7B2CFF" />

  <section class="bill halftone">
    <div class="wrap">
      <div class="grid">
        <div class="lead" style="grid-column: span 5">
          <p class="term-label kicker">Projects</p>
          <h2 class="display vibe-ov">What I’m working on.</h2>
          <p>
            I build models that read the world: financial news, Internet traffic, order books.
            Then I go for a long run and think about whether they’re right.
          </p>
          <a class="ticket" href="/setlist/">See all projects</a>
        </div>
        <ol class="marquee" style="grid-column: 7 / span 6">
          {bill.map((b) => (
            <li><span class="n">{b.n}</span><span class="t">{b.t}</span><span class="s">{b.s}</span></li>
          ))}
          <li class="encore"><span class="n">∞</span><span class="t">Also: the 3200m</span><span class="s">All-American, 2024</span></li>
        </ol>
      </div>
      <Circuit />
    </div>
  </section>

  <script>
    import { getDose } from '../scripts/dose';
    const b = document.getElementById('moire-b');
    let ticking = false;
    function update() {
      ticking = false;
      if (!b || getDose() === 'sober') return;
      const y = scrollY;
      b.setAttribute('transform', `translate(${(y * 0.06).toFixed(2)} ${(y * 0.04).toFixed(2)}) rotate(${(y * 0.01).toFixed(3)})`);
    }
    addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
    update();
  </script>
</Base>

<style>
  .hero {
    position: relative; overflow: hidden; isolation: isolate;
    min-height: min(100svh, 980px);
    display: grid; align-items: center;
    padding-block: 40px 120px;
    background: transparent;
  }
  .moire { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 1; mix-blend-mode: overlay; pointer-events: none; }
  .ringset { fill: none; stroke-width: 5; }
  .ringset.a { stroke: #23170D; opacity: .55; }
  .ringset.b { stroke: #E8DCC4; opacity: .6; transform-box: view-box; }
  :global(html:not([data-dose='sober'])) .ringset.a { animation: pulse var(--breath-dur) ease-in-out infinite; transform-origin: 0 0; transform-box: view-box; }
  @keyframes pulse { 50% { transform: scale(1.035) translate(4px, -3px); } }

  .stage { position: relative; z-index: 2; text-align: center; }
  .presents {
    display: inline-block; margin: 0 0 8px;
    background: var(--crt); color: var(--phosphor); padding: 4px 12px; border-radius: 4px;
    font-size: clamp(16px, 2vw, 22px);
  }
  .name { margin: 0 auto; max-width: 980px; transform: rotate(-3deg); }
  .name svg { width: 100%; height: auto; overflow: visible; display: block; }
  .face text { fill: #FF2E97; stroke: #B6FF3B; stroke-width: 7; paint-order: stroke; stroke-linejoin: round; }
  .shadow text { fill: inherit; }
  .letters { filter: url(#warp); }
  :global(html[data-dose='sober']) .letters { filter: none; }
  .stars path { fill: var(--orange); stroke: #23170D; stroke-width: 4; }

  .tagline { font-size: clamp(28px, 4.4vw, 56px); margin: -8px auto 14px; max-width: 18em; line-height: 1.1; }
  .tickets { display: flex; flex-wrap: wrap; justify-content: center; gap: 16px; margin-top: 30px; }

  .bill { padding: clamp(120px, 14vw, 180px) 0 40px; }
  .kicker { color: var(--violet); margin: 0; }
  .bill h2 { font-size: clamp(40px, 5.4vw, 64px); }
  .marquee {
    list-style: none; margin: 0; padding: 18px; counter-reset: s;
    background: var(--crt); border-radius: 10px; border: 4px solid var(--walnut);
    box-shadow: 8px 8px 0 var(--magenta);
  }
  .marquee li {
    display: grid; grid-template-columns: 52px 1fr; gap: 0 12px; align-items: baseline;
    padding: 12px 6px; border-bottom: 1px dashed #33ff6640;
    font-family: var(--font-term); color: var(--phosphor);
  }
  .marquee li:last-child { border-bottom: 0; }
  .n { font-size: 30px; color: var(--orange); grid-row: span 2; }
  .t { font-size: 28px; line-height: 1; }
  .s { font-size: 20px; color: #B6FF3Bcc; }
  .encore .t { color: var(--lime); }
</style>

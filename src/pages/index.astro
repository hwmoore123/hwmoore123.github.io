---
import Base from '../layouts/Base.astro';
import LiquidLight from '../components/LiquidLight.astro';
import Drip from '../components/Drip.astro';
import Splat from '../components/Splat.astro';
import Squiggle from '../components/Squiggle.astro';
import Bear from '../components/Bear.astro';

const bears = [
  { variant: 'code', name: 'Code Bear', fur: ['#B6FF3B', '#00C2B8', '#009DDC', '#7B2CFF', '#FF2E97', '#FDB827'] },
  { variant: 'run', name: 'Run Bear', fur: ['#FF8A1E', '#FDB827', '#FF2E97', '#7B2CFF', '#00C2B8', '#B6FF3B'] },
  { variant: 'math', name: 'Math Bear', fur: ['#7B2CFF', '#FF2E97', '#FF8A1E', '#FDB827', '#B6FF3B', '#00C2B8'] },
  { variant: 'market', name: 'Market Bear', fur: ['#FF2E97', '#7B2CFF', '#009DDC', '#00C2B8', '#B6FF3B', '#FF8A1E'] },
  { variant: 'wave', name: 'Waving Bear', fur: ['#FDB827', '#FF8A1E', '#FF2E97', '#7B2CFF', '#00C2B8', '#B6FF3B'] },
  { variant: 'dance', name: 'Dancing Bear', fur: ['#00C2B8', '#B6FF3B', '#FDB827', '#FF8A1E', '#FF2E97', '#7B2CFF'] },
] as const;

// wobbly, hand-drawn rings instead of perfect circles
const rings = Array.from({ length: 30 }, (_, i) => {
  const r0 = 16 + i * 14.5, k = 3 + (i % 4), ph = i * 1.7;
  let d = '';
  for (let j = 0; j <= 72; j++) {
    const a = (j / 72) * Math.PI * 2;
    const r = r0 * (1 + 0.035 * Math.sin(k * a + ph) + 0.02 * Math.sin((k + 3) * a - ph));
    d += `${j ? 'L' : 'M'}${(r * Math.cos(a)).toFixed(1)} ${(r * Math.sin(a)).toFixed(1)}`;
  }
  return d + 'Z';
});
const taglineWords = ['Computer', 'Science,', 'Economics,', 'and', 'Math', 'Student', '@', 'MIT'];
const tilt = [-6, 4, -3, 7, -5, 3, -8, 5];
const bill = [
  { n: '01', t: 'Mantis', s: 'news that moves markets' },
  { n: '02', t: 'Weighted PALU', s: 'the shape of Internet traffic' },
  { n: '03', t: 'IMC Prosperity 4', s: 'market making, made the final' },
  { n: '04', t: 'Runner Development App', s: 'less admin, more miles' },
];
---
<Base title="Wood Moore" page="home">
  <section class="hero" aria-labelledby="name">
    <LiquidLight />

    <svg class="moire" viewBox="-460 -460 920 920" aria-hidden="true" preserveAspectRatio="xMidYMid slice">
      <g class="ringset a">{rings.map((d) => <path d={d} />)}</g>
      <g class="ringset b" id="moire-b">{rings.map((d) => <path d={d} />)}</g>
    </svg>

    <div class="peek peek-l" aria-hidden="true"><Bear variant="head" uid="peek-l" label="" fur={['#FF2E97', '#FDB827', '#B6FF3B', '#00C2B8', '#7B2CFF', '#FF8A1E']} /></div>
    <div class="peek peek-r" aria-hidden="true"><Bear variant="head" uid="peek-r" label="" fur={['#00C2B8', '#7B2CFF', '#FF2E97', '#FF8A1E', '#FDB827', '#B6FF3B']} /></div>

    <div class="wrap stage">
      <p class="presents">Cambridge, Mass. · MIT Class of 2029</p>

      <h1 id="name" class="name breathe">
        <svg viewBox="0 0 1000 520" role="img" aria-labelledby="name-t">
          <title id="name-t">Wood Moore</title>
          <defs>
            <path id="arc-top" d="M70 255 Q500 -10 930 255" />
            <path id="arc-bot" d="M40 300 Q500 560 960 300" />
          </defs>
          <g class="letters display drift" font-family="Shrikhand, Georgia, serif">
            <g class="shadow" fill="#23170D" transform="translate(35 37)">
              <text font-size="190"><textPath href="#arc-top" startOffset="50%" text-anchor="middle" textLength="760" lengthAdjust="spacingAndGlyphs">WOOD</textPath></text>
              <text font-size="190"><textPath href="#arc-bot" startOffset="50%" text-anchor="middle" textLength="860" lengthAdjust="spacingAndGlyphs">MOORE</textPath></text>
            </g>
            <g class="shadow" fill="#61BB46" transform="translate(30 32)">
              <text font-size="190"><textPath href="#arc-top" startOffset="50%" text-anchor="middle" textLength="760" lengthAdjust="spacingAndGlyphs">WOOD</textPath></text>
              <text font-size="190"><textPath href="#arc-bot" startOffset="50%" text-anchor="middle" textLength="860" lengthAdjust="spacingAndGlyphs">MOORE</textPath></text>
            </g>
            <g class="shadow" fill="#FDB827" transform="translate(25 27)">
              <text font-size="190"><textPath href="#arc-top" startOffset="50%" text-anchor="middle" textLength="760" lengthAdjust="spacingAndGlyphs">WOOD</textPath></text>
              <text font-size="190"><textPath href="#arc-bot" startOffset="50%" text-anchor="middle" textLength="860" lengthAdjust="spacingAndGlyphs">MOORE</textPath></text>
            </g>
            <g class="shadow" fill="#F5821F" transform="translate(20 22)">
              <text font-size="190"><textPath href="#arc-top" startOffset="50%" text-anchor="middle" textLength="760" lengthAdjust="spacingAndGlyphs">WOOD</textPath></text>
              <text font-size="190"><textPath href="#arc-bot" startOffset="50%" text-anchor="middle" textLength="860" lengthAdjust="spacingAndGlyphs">MOORE</textPath></text>
            </g>
            <g class="shadow" fill="#E03A3E" transform="translate(15 17)">
              <text font-size="190"><textPath href="#arc-top" startOffset="50%" text-anchor="middle" textLength="760" lengthAdjust="spacingAndGlyphs">WOOD</textPath></text>
              <text font-size="190"><textPath href="#arc-bot" startOffset="50%" text-anchor="middle" textLength="860" lengthAdjust="spacingAndGlyphs">MOORE</textPath></text>
            </g>
            <g class="shadow" fill="#963D97" transform="translate(10 12)">
              <text font-size="190"><textPath href="#arc-top" startOffset="50%" text-anchor="middle" textLength="760" lengthAdjust="spacingAndGlyphs">WOOD</textPath></text>
              <text font-size="190"><textPath href="#arc-bot" startOffset="50%" text-anchor="middle" textLength="860" lengthAdjust="spacingAndGlyphs">MOORE</textPath></text>
            </g>
            <g class="shadow" fill="#009DDC" transform="translate(5 7)">
              <text font-size="190"><textPath href="#arc-top" startOffset="50%" text-anchor="middle" textLength="760" lengthAdjust="spacingAndGlyphs">WOOD</textPath></text>
              <text font-size="190"><textPath href="#arc-bot" startOffset="50%" text-anchor="middle" textLength="860" lengthAdjust="spacingAndGlyphs">MOORE</textPath></text>
            </g>
            <g class="face">
              <text font-size="190"><textPath href="#arc-top" startOffset="50%" text-anchor="middle" textLength="760" lengthAdjust="spacingAndGlyphs">WOOD</textPath></text>
              <text font-size="190"><textPath href="#arc-bot" startOffset="50%" text-anchor="middle" textLength="860" lengthAdjust="spacingAndGlyphs">MOORE</textPath></text>
            </g>
          </g>
          <g class="stars" aria-hidden="true">
            <path d="M500 220 l10 24 l26 2 l-20 16 l7 25 l-23 -14 l-23 14 l7 -25 l-20 -16 l26 -2 Z" />
          </g>
        </svg>
      </h1>

      <p class="tagline" aria-label="Computer Science, Economics, and Math Student @ MIT">
        {taglineWords.map((w, i) => <span aria-hidden="true" style={`--t:${tilt[i]}deg`}>{w}</span>)}
      </p>

      <p class="scrawl s-me" aria-hidden="true">
        <svg viewBox="0 0 120 60"><path d="M112 10 C80 4 40 18 14 44 M14 44 L16 26 M14 44 L32 42" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" /></svg>
        hi, that’s me
      </p>

      <nav class="tickets" aria-label="Start here">
        <a class="ticket" href="/projects/">See my projects</a>
        <a class="ticket alt" href="/about/">About me</a>
        <a class="ticket alt2" href="/contact/">Get in touch</a>
      </nav>
    </div>
  </section>

  <Drip color="#7B2CFF" />

  <section class="bears" aria-labelledby="bears-h">
    <Splat seed={3} color="#FF2E97" style="width: 360px; left: -80px; top: 120px;" />
    <Splat seed={8} color="#B6FF3B" style="width: 280px; right: -40px; top: 40%;" />
    <Splat seed={13} color="#00C2B8" style="width: 240px; left: 38%; bottom: -60px;" />
    <div class="wrap">
      <p class="term-label kicker">The crew</p>
      <h2 id="bears-h" class="display vibe-ml">Meet the bears.</h2>
      <p class="scrawl s-bears" aria-hidden="true">they’re friendly, mostly</p>
      <ul class="bear-grid">
        {bears.map((b, i) => (
          <li class={`bear-card c${i}`}>
            <Bear variant={b.variant} uid={`b${i}`} fur={[...b.fur]} label={`${b.name}, an original psychedelic bear illustration`} />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="bill">
    <Splat seed={21} color="#FDB827" style="width: 320px; right: 4%; top: -40px;" />
    <div class="wrap">
      <div class="grid">
        <div class="lead" style="grid-column: span 5">
          <p class="term-label kicker">Projects</p>
          <h2 class="display vibe-ov">What I’m working on.</h2>
          <p>
            I build models that read the world: financial news, Internet traffic, order books.
            Then I go for a long run and think about whether they’re right.
          </p>
          <a class="ticket" href="/projects/">See all projects</a>
        </div>
        <ol class="marquee" style="grid-column: 7 / span 6">
          {bill.map((b) => (
            <li><span class="n">{b.n}</span><span class="t">{b.t}</span><span class="s">{b.s}</span></li>
          ))}
          <li class="encore"><span class="n">∞</span><span class="t">Also: the 3200m</span><span class="s">All-American, 2024</span></li>
        </ol>
      </div>
      <Squiggle />
    </div>
  </section>

  <script>
    import { getDose } from '../scripts/dose';
    const b = document.getElementById('moire-b');
    let ticking = false;
    function update() {
      ticking = false;
      if (!b || getDose() === 'sober') return;
      const y = scrollY;
      b.setAttribute('transform', `translate(${(y * 0.06).toFixed(2)} ${(y * 0.04).toFixed(2)}) rotate(${(y * 0.01).toFixed(3)})`);
    }
    addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
    update();
  </script>
</Base>

<style>
  .hero {
    position: relative; overflow: hidden; isolation: isolate;
    min-height: min(100svh, 980px);
    display: grid; align-items: center;
    padding-block: 40px 120px;
    background: transparent;
  }
  .moire { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 1; mix-blend-mode: overlay; pointer-events: none; }
  .ringset { fill: none; stroke-width: 5; stroke-linejoin: round; }
  .ringset.a { stroke: #23170D; opacity: .55; }
  .ringset.b { stroke: #E8DCC4; opacity: .6; transform-box: view-box; }
  :global(html:not([data-dose='sober'])) .ringset.a { animation: pulse var(--breath-dur) ease-in-out infinite; transform-origin: 0 0; transform-box: view-box; }
  @keyframes pulse { 50% { transform: scale(1.035) translate(4px, -3px); } }

  .stage { position: relative; z-index: 2; text-align: center; }
  /* scrawled on a strip of masking tape */
  .presents {
    display: inline-block; margin: 0 0 8px; transform: rotate(-4deg) translateX(-12%);
    background: rgba(253, 184, 39, .9); color: var(--ink);
    padding: 8px 18px 6px;
    font-family: var(--font-hand); font-size: clamp(15px, 1.9vw, 21px);
    clip-path: polygon(2% 0, 98% 4%, 100% 50%, 97% 100%, 1% 96%, 0 50%);
    box-shadow: 0 2px 0 rgba(0,0,0,.2);
  }
  .scrawl {
    position: absolute; margin: 0; z-index: 3;
    font-family: var(--font-hand); color: var(--ink); line-height: 1;
    text-shadow: 2px 2px 0 #fff8, -1px -1px 0 #fff8;
    pointer-events: none;
  }
  .scrawl svg { display: block; width: 100px; color: var(--ink); filter: url(#rough); }
  .s-me { right: 4%; top: 30%; font-size: clamp(20px, 2.4vw, 32px); transform: rotate(9deg); display: flex; flex-direction: column; align-items: flex-start; gap: 0; }
  .s-me svg { transform: scaleX(-1) rotate(-10deg); margin-bottom: 6px; }
  .s-bears { position: relative; display: table; font-size: clamp(18px, 2vw, 26px); transform: rotate(-5deg); margin: 18px 0 0 32%; color: var(--ink); background: var(--lime); padding: 4px 10px; text-shadow: none; }
  @media (max-width: 760px) { .s-me { display: none; } }
  .name { margin: 0 auto; max-width: 980px; transform: rotate(-3deg); }
  .name svg { width: 100%; height: auto; overflow: visible; display: block; }
  .face text { fill: #FF2E97; stroke: #B6FF3B; stroke-width: 7; paint-order: stroke; stroke-linejoin: round; }
  .shadow text { fill: inherit; }
  .letters { filter: url(#warp); }
  :global(html[data-dose='sober']) .letters { filter: none; }
  .stars path { fill: var(--orange); stroke: #23170D; stroke-width: 4; }

  .tagline {
    font-family: var(--font-hand); font-size: clamp(26px, 4vw, 52px);
    margin: -4px auto 14px; max-width: 16em; line-height: 1.25;
    display: flex; flex-wrap: wrap; justify-content: center; gap: 0 .35em;
    color: var(--lime);
    -webkit-text-stroke: 2px var(--ink); paint-order: stroke fill;
    text-shadow: 3px 3px 0 var(--magenta), 6px 6px 0 var(--ink);
  }
  .tagline span { display: inline-block; transform: rotate(var(--t)) translateY(calc(var(--t) * .8px)); }
  .tagline span:nth-child(3n) { color: var(--orange); }
  .tagline span:nth-child(4n+1) { color: #fff; }
  .tickets { display: flex; flex-wrap: wrap; justify-content: center; gap: 16px; margin-top: 30px; }

  .bill { position: relative; padding: 50px 0 40px; }
  .bears > .wrap, .bill > .wrap { position: relative; z-index: 1; }

  /* ---------- bears ---------- */
  .peek { position: absolute; z-index: 1; width: clamp(150px, 24vw, 340px); pointer-events: none; animation: peek 7s ease-in-out infinite; }
  .peek-l { left: -3%; bottom: -2%; --tilt: 18deg; }
  .peek-r { right: -3%; top: 14%; --tilt: -22deg; animation-delay: -3.5s; }
  @keyframes peek {
    0%, 100% { transform: rotate(var(--tilt)) translateY(30%); }
    50% { transform: rotate(calc(var(--tilt) * -.4)) translateY(0) scale(1.08); }
  }
  :global(html[data-dose='trip']) .peek { animation-duration: 4s; }
  :global(html[data-dose='sober']) .peek { animation: none; transform: rotate(var(--tilt)); }
  @media (max-width: 760px) { .peek { width: 120px; opacity: .9; } .peek-r { top: auto; bottom: 30%; } }

  .bears { position: relative; padding: clamp(120px, 14vw, 180px) 0 40px; overflow: hidden; }
  .bears h2 { font-size: clamp(44px, 7vw, 92px); transform: rotate(-4deg); margin: 14px 0 0; }
  .bear-grid { list-style: none; margin: 10px 0 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; align-items: center; }
  /* die-cut stickers: white outline + slightly lifted shadow, slapped on at odd angles */
  .bear-card {
    position: relative;
    filter:
      drop-shadow(4px 0 0 #FFF8EA) drop-shadow(-4px 0 0 #FFF8EA)
      drop-shadow(0 4px 0 #FFF8EA) drop-shadow(0 -4px 0 #FFF8EA)
      drop-shadow(6px 9px 0 rgba(35, 23, 13, .45));
    transition: transform .4s cubic-bezier(.3, 1.6, .5, 1);
  }
  .bear-card.c0 { width: 30%; transform: rotate(-11deg) translate(4%, 6%); z-index: 2; }
  .bear-card.c1 { width: 22%; transform: rotate(9deg) translate(-8%, -14%); z-index: 1; }
  .bear-card.c2 { width: 27%; transform: rotate(-4deg) translate(-12%, 12%); z-index: 3; }
  .bear-card.c3 { width: 25%; transform: rotate(14deg) translate(-16%, -4%); z-index: 2; }
  .bear-card.c4 { width: 24%; transform: rotate(7deg) translate(10%, -16%); z-index: 3; }
  .bear-card.c5 { width: 26%; transform: rotate(-12deg) translate(-6%, -10%); z-index: 1; }
  .bear-card:hover { transform: rotate(0) scale(1.12); z-index: 5; }
  .bear-card:hover :global(.halo) { animation-duration: 4s; }
  @media (max-width: 960px) {
    .bear-card.c0, .bear-card.c2, .bear-card.c4 { width: 52%; }
    .bear-card.c1, .bear-card.c3, .bear-card.c5 { width: 44%; }
  }
  @media (max-width: 480px) {
    .bear-card.c0, .bear-card.c1, .bear-card.c2, .bear-card.c3, .bear-card.c4, .bear-card.c5 { width: 66%; }
    .bear-card.c0 { margin-right: 26%; }
    .bear-card.c1, .bear-card.c3, .bear-card.c5 { margin-left: 26%; margin-top: -10%; }
    .bear-card.c2, .bear-card.c4 { margin-top: -10%; margin-right: 26%; }
    .bear-card.c0 { transform: rotate(-9deg); }
    .bear-card.c1 { transform: rotate(8deg); }
    .bear-card.c2 { transform: rotate(-5deg); }
    .bear-card.c3 { transform: rotate(10deg); }
    .bear-card.c4 { transform: rotate(-7deg); }
    .bear-card.c5 { transform: rotate(6deg); }
  }
  .kicker { color: var(--violet); margin: 0; }
  .bill h2 { font-size: clamp(40px, 5.4vw, 64px); }
  .marquee {
    list-style: none; margin: 0; padding: 18px; counter-reset: s;
    background: var(--crt); border-radius: 10px; border: 4px solid var(--walnut);
    box-shadow: 8px 8px 0 var(--magenta);
  }
  .marquee li {
    display: grid; grid-template-columns: 52px 1fr; gap: 0 12px; align-items: baseline;
    padding: 12px 6px; border-bottom: 1px dashed #33ff6640;
    font-family: var(--font-term); color: var(--phosphor);
  }
  .marquee li:last-child { border-bottom: 0; }
  .n { font-size: 30px; color: var(--orange); grid-row: span 2; }
  .t { font-size: 28px; line-height: 1; }
  .s { font-size: 20px; color: #B6FF3Bcc; }
  .encore .t { color: var(--lime); }
</style>

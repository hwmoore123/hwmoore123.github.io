---
import '@fontsource/shrikhand/latin-400.css';
import '@fontsource/vt323/latin-400.css';
import '@fontsource-variable/fraunces/full.css';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Knob from '../components/Knob.astro';
import Stickers from '../components/Stickers.astro';

interface Props { title: string; description?: string; page?: string }
const {
  title,
  description = 'Wood Moore — MIT student in CS, economics and applied math, ML researcher, distance runner. Math, markets, and miles.',
  page = '',
} = Astro.props;
const fullTitle = title === 'Wood Moore' ? title : `${title} · Wood Moore`;
---
<!doctype html>
<html lang="en" data-dose="contact">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#5C3A21" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <!-- Set the dose before first paint: saved choice > reduced-motion > Contact high -->
    <script is:inline>
      (function () {
        var d = null, el = document.documentElement;
        try { d = localStorage.getItem('dose'); } catch (e) {}
        if (d) el.setAttribute('data-dose-chosen', '');
        if (!d) d = matchMedia('(prefers-reduced-motion: reduce)').matches ? 'sober' : 'contact';
        if (['sober', 'contact', 'trip'].indexOf(d) < 0) d = 'contact';
        el.dataset.dose = d;
      })();
    </script>
  </head>
  <body data-page={page}>
    <a class="skip" href="#main">Skip to content</a>
    <div id="tiedye" class="tiedye" aria-hidden="true"></div>
    <Stickers />

    <!-- Shared SVG filters. #warp is only ever applied to display type. -->
    <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
      <filter id="warp" x="-10%" y="-20%" width="120%" height="140%">
        <feTurbulence id="warp-turb" type="fractalNoise" baseFrequency="0.012 0.02" numOctaves="2" seed="4" result="noise" />
        <feDisplacementMap id="warp-disp" in="SourceGraphic" in2="noise" scale="0" xChannelSelector="R" yChannelSelector="G" />
      </filter>
    </svg>

    <Nav current={page} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <Knob />

    <div class="notice" id="notice" role="status" hidden>
      <p>This site moves. Turn the knob to <strong>Sober</strong> anytime.</p>
      <button type="button" id="notice-ok">Groovy</button>
    </div>

    <canvas id="trail" aria-hidden="true"></canvas>

    <script>
      import '../scripts/dial';
      import '../scripts/tiedye';
    </script>
    <style>
      .notice {
        position: fixed; left: 50%; bottom: 24px; z-index: 80;
        transform: translateX(-50%);
        display: flex; align-items: center; gap: 16px;
        max-width: calc(100vw - 32px);
        padding: 12px 14px 12px 20px;
        background: var(--crt); color: var(--phosphor);
        font-family: var(--font-term); font-size: 22px; line-height: 1.2;
        border: 3px solid var(--magenta); border-radius: 10px;
        box-shadow: 6px 6px 0 var(--violet);
      }
      .notice[hidden] { display: none; }
      .notice p { margin: 0; }
      .notice strong { color: var(--lime); font-weight: 400; }
      .notice button {
        font: inherit; color: var(--ink); background: var(--lime);
        border: 0; border-radius: 6px; padding: 6px 14px; cursor: pointer; white-space: nowrap;
      }
      #trail { position: fixed; inset: 0; width: 100vw; height: 100vh; pointer-events: none; z-index: 70; }
    </style>
  </body>
</html>
